---
interface Props {
  id: string;
  name: string;
  rating: number;
  badge?: string;
  architecture: string;
  speed: string;
  unlocks: string[];
  price: string;
  coupon: string;
  discount: string;
  url: string;
  description: string;
}

const {
  id,
  name,
  rating,
  badge,
  architecture,
  speed,
  unlocks,
  price,
  coupon,
  discount,
  url,
  description
} = Astro.props;
---

<div class="relative bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
  {badge && (
    <div class="absolute -top-3 right-6 bg-gradient-to-r from-amber-500 to-rose-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-md shadow-rose-500/20">
      {badge}
    </div>
  )}

  <div>
    <!-- Top Header -->
    <div class="flex items-start justify-between gap-4 mb-4">
      <div>
        <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-sky-500 transition-colors">
          {name}
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          {architecture} • {speed}
        </p>
      </div>

      <!-- Score Badge -->
      <div class="flex flex-col items-center justify-center px-3 py-1.5 rounded-xl bg-sky-50 dark:bg-sky-950/60 border border-sky-200 dark:border-sky-800 text-sky-600 dark:text-sky-400">
        <span class="text-xs font-semibold">综合评分</span>
        <span class="text-lg font-black leading-none mt-0.5">{rating}</span>
      </div>
    </div>

    <!-- Description -->
    <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
      {description}
    </p>

    <!-- Unlocks Badges -->
    <div class="mb-5">
      <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 block mb-2">解锁与支持服务：</span>
      <div class="flex flex-wrap gap-1.5">
        {unlocks.map(item => (
          <span class="text-xs px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 font-medium border border-emerald-200/60 dark:border-emerald-800/60">
            ✓ {item}
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="space-y-4 pt-4 border-t border-slate-100 dark:border-slate-800">
    <!-- Coupon Box -->
    <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-dashed border-slate-300 dark:border-slate-700">
      <div>
        <span class="text-xs text-slate-400 dark:text-slate-500 block">专属优惠码 ({discount})</span>
        <code class="text-sm font-mono font-bold text-amber-600 dark:text-amber-400">{coupon}</code>
      </div>
      <button
        type="button"
        data-coupon={coupon}
        class="copy-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 hover:bg-slate-100 dark:hover:bg-slate-600 transition-colors"
      >
        复制优惠码
      </button>
    </div>

    <!-- Price & Action Button -->
    <div class="flex items-center justify-between gap-4">
      <div>
        <span class="text-xs text-slate-400 dark:text-slate-500">套餐价格</span>
        <div class="text-lg font-black text-slate-900 dark:text-white">
          {price}
        </div>
      </div>

      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 max-w-[180px] text-center px-4 py-2.5 rounded-xl bg-gradient-to-r from-sky-500 via-indigo-500 to-indigo-600 hover:from-sky-600 hover:to-indigo-700 text-white font-bold text-sm shadow-md shadow-sky-500/20 hover:shadow-sky-500/30 transition-all flex items-center justify-center gap-1 group/btn"
      >
        直达官网通道
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const code = target.getAttribute('data-coupon');
      if (code) {
        try {
          await navigator.clipboard.writeText(code);
          const originalText = target.innerText;
          target.innerText = '已复制！';
          target.classList.add('text-emerald-600', 'dark:text-emerald-400');
          setTimeout(() => {
            target.innerText = originalText;
            target.classList.remove('text-emerald-600', 'dark:text-emerald-400');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy', err);
        }
      }
    });
  });
</script>
