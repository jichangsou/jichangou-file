---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { label: '首页', href: '/' },
  { label: '🔥 热门推荐', href: '/#popular' },
  { label: '📊 测评大盘', href: '/monitor' },
  { label: '🛠️ 客户端教程', href: '/#tutorials' },
  { label: '📚 全部文章', href: '/posts' },
  { label: '⚖️ 免责声明', href: '/about' },
];
---

<header class="sticky top-0 z-50 bg-white/85 dark:bg-slate-900/85 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-sky-500/20 group-hover:scale-105 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-black bg-gradient-to-r from-slate-900 via-sky-800 to-indigo-900 dark:from-white dark:to-slate-200 bg-clip-text text-transparent leading-none">
            极速节点测评
          </span>
          <span class="text-[10px] text-slate-400 font-medium tracking-tight">Node & Airport Review</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-6">
        {navItems.map(item => (
          <a
            href={item.href}
            class="text-xs font-semibold text-slate-600 hover:text-sky-600 dark:text-slate-300 dark:hover:text-sky-400 transition-colors"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <ThemeToggle />

        <a
          href="/#popular"
          class="hidden sm:inline-flex items-center gap-1 text-xs font-bold px-3.5 py-1.5 rounded-full bg-gradient-to-r from-sky-500 to-indigo-600 text-white shadow-md shadow-sky-500/20 hover:shadow-sky-500/30 transition-all"
        >
          查看热门节点 ⚡
        </a>
      </div>
    </div>

    <!-- Mobile Nav Scrollbar -->
    <div class="md:hidden flex items-center gap-4 py-2 overflow-x-auto border-t border-slate-100 dark:border-slate-800 text-xs font-medium no-scrollbar">
      {navItems.map(item => (
        <a
          href={item.href}
          class="whitespace-nowrap text-slate-600 dark:text-slate-300 hover:text-sky-500 px-1 py-0.5"
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>
