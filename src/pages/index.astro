---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecommendationCard from '../components/RecommendationCard.astro';
import PostCard from '../components/PostCard.astro';
import { recommendations } from '../data/recommendations';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const tutorials = [
  {
    name: 'Clash Verge Rev',
    platform: 'Windows / macOS',
    icon: '⚡',
    link: '/posts/clash-tutorial/#步骤二clash-verge-rev-导入配置-windows--macos',
    desc: '开源极速，支持 Mihomo 核心与 TUN 模式'
  },
  {
    name: 'Sing-box',
    platform: '全平台 (iOS/Android/Mac/Win)',
    icon: '📦',
    link: '/posts/clash-tutorial/#步骤三sing-box-跨平台订阅配置指南',
    desc: '新一代原生理性协议引擎，支持 Hysteria 2'
  },
  {
    name: 'Stash',
    platform: 'iOS / macOS',
    icon: '📱',
    link: '/posts/clash-tutorial',
    desc: 'iOS 最佳全功能客户端，规则重写强大'
  },
  {
    name: 'Shadowrocket (小火箭)',
    platform: 'iOS',
    icon: '🚀',
    link: '/posts/clash-tutorial',
    desc: '经典小白首选，扫码即用方便快捷'
  }
];
---

<BaseLayout
  title="2026 稳定网络节点与加速工具测评网 | 机场选型与客户端配置教程"
  description="专业客观的网络节点评测平台，实时压测 IPLC 专线与 BGP 中转性能，提供 Clash / Sing-box / Shadowrocket 完整客户端订阅导入指南及专属优惠码。"
>
  <!-- Hero Section Banner -->
  <section class="relative py-12 sm:py-16 text-center space-y-6">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-sky-500/10 via-indigo-500/10 to-amber-500/10 text-sky-600 dark:text-sky-400 text-xs font-extrabold border border-sky-200 dark:border-sky-800">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      2026 最新压测数据已更新（自动化 24/7 监控中）
    </div>

    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight max-w-4xl mx-auto">
      精准节点评测，拒绝断连套路 <br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-sky-500 via-indigo-500 to-purple-500 bg-clip-text text-transparent">
        高速 IPLC 专线与客户端全套教程
      </span>
    </h1>

    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
      为你提供基于 5 维客观打分的网络节点选型推荐、晚高峰丢包压测、ChatGPT/Claude 住宅 IP 解锁支持以及完整 Clash / Sing-box 订阅导入指南。
    </p>

    <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
      <a
        href="#popular"
        class="px-6 py-3 rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-600 hover:to-indigo-700 text-white font-bold text-sm shadow-lg shadow-sky-500/25 hover:shadow-sky-500/40 hover:-translate-y-0.5 transition-all"
      >
        🔥 查看热门节点推荐
      </a>
      <a
        href="#tutorials"
        class="px-6 py-3 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 font-bold text-sm border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
      >
        🛠️ 客户端订阅教程
      </a>
    </div>
  </section>

  <!-- Popular Recommendations Section -->
  <section id="popular" class="py-12 border-t border-slate-200/80 dark:border-slate-800/80 scroll-mt-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <div class="text-xs font-extrabold text-sky-600 dark:text-sky-400 uppercase tracking-wider mb-1">
          HOT RECOMMENDATIONS
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
          🔥 热门节点推荐榜单
        </h2>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        包含专属折扣优惠码，点击按钮即可一键复制并跳转
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {recommendations.map(item => (
        <RecommendationCard {...item} />
      ))}
    </div>
  </section>

  <!-- Client Tutorials Entry Grid Section -->
  <section id="tutorials" class="py-12 border-t border-slate-200/80 dark:border-slate-800/80 scroll-mt-20">
    <div class="flex items-center justify-between mb-8">
      <div>
        <div class="text-xs font-extrabold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-1">
          CLIENT TUTORIALS
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
          🛠️ 常用客户端小白教程速查
        </h2>
      </div>
      <a href="/posts/clash-tutorial" class="text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline">
        完整详细教程 →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {tutorials.map(t => (
        <a
          href={t.link}
          class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-sky-500 dark:hover:border-sky-500 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all block group"
        >
          <div class="text-2xl mb-2">{t.icon}</div>
          <div class="text-xs font-semibold text-sky-600 dark:text-sky-400">{t.platform}</div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-sky-500 transition-colors mt-0.5">
            {t.name}
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 leading-relaxed">
            {t.desc}
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest Blog Reviews Section -->
  <section class="py-12 border-t border-slate-200/80 dark:border-slate-800/80">
    <div class="flex items-center justify-between mb-8">
      <div>
        <div class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider mb-1">
          LATEST ARTICLES
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
          📰 最新测评与技术干货
        </h2>
      </div>
      <a href="/posts" class="text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline">
        查看全部 ({allPosts.length}) →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {sortedPosts.map(post => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.slug}
          tags={post.data.tags}
          heroImage={post.data.heroImage}
        />
      ))}
    </div>
  </section>
</BaseLayout>
