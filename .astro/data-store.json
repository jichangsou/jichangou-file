[["Map",1,2,9,10],"meta::meta",["Map",3,4,5,6,7,8],"astro-version","5.18.2","content-config-digest","fac194b5d00b3d4e","astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"site\":\"http://localhost:4321\",\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"attribute\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":true,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":\"0.0.0.0\",\"port\":4321,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":{\"type\":\"shiki\",\"excludeLangs\":[\"math\"]},\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark\",\"themes\":{},\"wrap\":false,\"transformers\":[]},\"remarkPlugins\":[],\"rehypePlugins\":[],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true,\"allowedDomains\":[],\"actionBodySizeLimit\":1048576},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false,\"failOnPrerenderConflict\":false,\"svgo\":false},\"legacy\":{\"collections\":false}}","blog",["Map",11,12,54,55,88,89],"frontend-2026",{"id":11,"data":13,"body":23,"filePath":24,"digest":25,"rendered":26,"legacyId":53},{"title":14,"description":15,"pubDate":16,"author":17,"tags":18,"heroImage":22},"2026 年前端技术趋势展望：AI 驱动、极简演进与 Serverless 普及","盘点 2026 年前端生态的关键变化：AI 编码助手深度融合、全栈元框架的范式演进与零运行时 CSS 的复兴。",["Date","2026-08-19T00:00:00.000Z"],"Antigravity Dev",[19,20,21],"前端趋势","AI","全栈","https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1200&q=80","## 前言\n\n随着 AI Agent 技术的深度演进与浏览器基础能力的增强，前端开发正经历一场前所未有的范式变革。本文将深入梳理 2026 年值得重点关注的三大前端技术演进方向。\n\n---\n\n## 核心趋势\n\n### 1. AI 原生驱动的组件生成与工作流\n\n代码不再仅仅是通过手动逐行敲出，AI 编程工具已经从“辅助补全”蜕变为“Agent 协同研发”。开发者更侧重于架构设计、业务逻辑编排与设计系统 (Design System) 的落地。\n\n### 2. 静态优先 (Static-First) 与极简 runtime\n\n过多冗余的框架运行时被逐渐淘汰。以 **Astro** 为代表的零 JS/极简 JS 方案在博客、内容型平台和电子商务网站中大放异彩。\n\n```bash\n# 生成极其轻量的 HTML/CSS 构建产物\nnpm run build\n```\n\n### 3. 边缘计算与无缝部署\n\n全栈框架不再绑定单一服务器，一键部署到 Cloudflare Global Network、Vercel Edge Network 成为行业标准规范。\n\n---\n\n## 结论\n\n拥抱变化、专注用户体验与内容质量，永远是开发者不变的主题。","src/content/blog/frontend-2026.md","7a656a6661fbbb18",{"html":27,"metadata":28},"\u003Ch2 id=\"前言\">前言\u003C/h2>\n\u003Cp>随着 AI Agent 技术的深度演进与浏览器基础能力的增强，前端开发正经历一场前所未有的范式变革。本文将深入梳理 2026 年值得重点关注的三大前端技术演进方向。\u003C/p>\n\u003Chr>\n\u003Ch2 id=\"核心趋势\">核心趋势\u003C/h2>\n\u003Ch3 id=\"1-ai-原生驱动的组件生成与工作流\">1. AI 原生驱动的组件生成与工作流\u003C/h3>\n\u003Cp>代码不再仅仅是通过手动逐行敲出，AI 编程工具已经从“辅助补全”蜕变为“Agent 协同研发”。开发者更侧重于架构设计、业务逻辑编排与设计系统 (Design System) 的落地。\u003C/p>\n\u003Ch3 id=\"2-静态优先-static-first-与极简-runtime\">2. 静态优先 (Static-First) 与极简 runtime\u003C/h3>\n\u003Cp>过多冗余的框架运行时被逐渐淘汰。以 \u003Cstrong>Astro\u003C/strong> 为代表的零 JS/极简 JS 方案在博客、内容型平台和电子商务网站中大放异彩。\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"bash\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#6A737D\"># 生成极其轻量的 HTML/CSS 构建产物\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#B392F0\">npm\u003C/span>\u003Cspan style=\"color:#9ECBFF\"> run\u003C/span>\u003Cspan style=\"color:#9ECBFF\"> build\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch3 id=\"3-边缘计算与无缝部署\">3. 边缘计算与无缝部署\u003C/h3>\n\u003Cp>全栈框架不再绑定单一服务器，一键部署到 Cloudflare Global Network、Vercel Edge Network 成为行业标准规范。\u003C/p>\n\u003Chr>\n\u003Ch2 id=\"结论\">结论\u003C/h2>\n\u003Cp>拥抱变化、专注用户体验与内容质量，永远是开发者不变的主题。\u003C/p>",{"headings":29,"localImagePaths":47,"remoteImagePaths":48,"frontmatter":49,"imagePaths":52},[30,33,35,39,42,45],{"depth":31,"slug":32,"text":32},2,"前言",{"depth":31,"slug":34,"text":34},"核心趋势",{"depth":36,"slug":37,"text":38},3,"1-ai-原生驱动的组件生成与工作流","1. AI 原生驱动的组件生成与工作流",{"depth":36,"slug":40,"text":41},"2-静态优先-static-first-与极简-runtime","2. 静态优先 (Static-First) 与极简 runtime",{"depth":36,"slug":43,"text":44},"3-边缘计算与无缝部署","3. 边缘计算与无缝部署",{"depth":31,"slug":46,"text":46},"结论",[],[],{"title":14,"description":15,"pubDate":50,"author":17,"tags":51,"heroImage":22},["Date","2026-08-19T00:00:00.000Z"],[19,20,21],[],"frontend-2026.md","astro-guide",{"id":54,"data":56,"body":65,"filePath":66,"digest":67,"rendered":68,"legacyId":87},{"title":57,"description":58,"pubDate":59,"author":17,"tags":60,"heroImage":64},"使用 Astro 搭建现代极速静态博客","深入了解 Astro 框架的架构优势、Islands 孤岛渲染机制以及零 JavaScript 默认打包。",["Date","2026-08-15T00:00:00.000Z"],[61,62,63],"Astro","前端框架","静态站点","https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1200&q=80","## 为什么选择 Astro？\n\n**Astro** 是一款专为构建内容丰富型网站（如博客、文档、营销页面）而设计的现代 Web 框架。相比于传统的 Single Page Application (SPA) 框架，Astro 引入了令人瞩目的 **Islands Architecture (孤岛架构)**。\n\n### 核心亮点\n\n1. **默认 0KB JavaScript**：Astro 默认在客户端发送 0KB JS，所有静态 HTML 在构建阶段预渲染。\n2. **群岛架构 (Component Islands)**：仅对需要交互的部分引入动态组件（React, Vue, Svelte 等）。\n3. **Markdown / MDX 一等公民支持**：开箱即用的 Content Collections 强类型校验与格式化支持。\n4. **原生 SEO 友好**：支持自动生成 Sitemap、RSS 订阅源以及完美的 Meta 标签集成。\n\n---\n\n## 快速代码示例\n\n下面是一个简易的 Astro 页面代码段：\n\n```astro\n---\nimport Layout from '../layouts/BaseLayout.astro';\nconst pageTitle = \"我的第一个 Astro 博客\";\n---\n\n\u003CLayout title={pageTitle}>\n  \u003Cmain class=\"max-w-4xl mx-auto py-8\">\n    \u003Ch1 class=\"text-3xl font-bold\">欢迎来到 Astro 世界 🚀\u003C/h1>\n  \u003C/main>\n\u003C/Layout>\n```\n\n> 💡 **提示**：Astro 的 Frontmatter 部分在构建时在服务器端执行，不会暴露给客户端浏览器！\n\n---\n\n## 总结\n\nAstro 极大地简化了现代全栈博客的构建难度，兼顾了顶级开发体验与极致的页面加载速度。如果你也在寻求一个高速、SEO 友好且易于扩展的博客解决方案，Astro 无疑是当下最佳选择之一。","src/content/blog/astro-guide.md","231edfc067db2fd8",{"html":69,"metadata":70},"\u003Ch2 id=\"为什么选择-astro\">为什么选择 Astro？\u003C/h2>\n\u003Cp>\u003Cstrong>Astro\u003C/strong> 是一款专为构建内容丰富型网站（如博客、文档、营销页面）而设计的现代 Web 框架。相比于传统的 Single Page Application (SPA) 框架，Astro 引入了令人瞩目的 \u003Cstrong>Islands Architecture (孤岛架构)\u003C/strong>。\u003C/p>\n\u003Ch3 id=\"核心亮点\">核心亮点\u003C/h3>\n\u003Col>\n\u003Cli>\u003Cstrong>默认 0KB JavaScript\u003C/strong>：Astro 默认在客户端发送 0KB JS，所有静态 HTML 在构建阶段预渲染。\u003C/li>\n\u003Cli>\u003Cstrong>群岛架构 (Component Islands)\u003C/strong>：仅对需要交互的部分引入动态组件（React, Vue, Svelte 等）。\u003C/li>\n\u003Cli>\u003Cstrong>Markdown / MDX 一等公民支持\u003C/strong>：开箱即用的 Content Collections 强类型校验与格式化支持。\u003C/li>\n\u003Cli>\u003Cstrong>原生 SEO 友好\u003C/strong>：支持自动生成 Sitemap、RSS 订阅源以及完美的 Meta 标签集成。\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 id=\"快速代码示例\">快速代码示例\u003C/h2>\n\u003Cp>下面是一个简易的 Astro 页面代码段：\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"astro\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#6A737D\">---\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">import\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> Layout \u003C/span>\u003Cspan style=\"color:#F97583\">from\u003C/span>\u003Cspan style=\"color:#9ECBFF\"> '../layouts/BaseLayout.astro'\u003C/span>\u003Cspan style=\"color:#E1E4E8\">;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#F97583\">const\u003C/span>\u003Cspan style=\"color:#79B8FF\"> pageTitle\u003C/span>\u003Cspan style=\"color:#F97583\"> =\u003C/span>\u003Cspan style=\"color:#9ECBFF\"> \"我的第一个 Astro 博客\"\u003C/span>\u003Cspan style=\"color:#E1E4E8\">;\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#6A737D\">---\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">&#x3C;\u003C/span>\u003Cspan style=\"color:#79B8FF\">Layout\u003C/span>\u003Cspan style=\"color:#B392F0\"> title\u003C/span>\u003Cspan style=\"color:#E1E4E8\">={pageTitle}>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">  &#x3C;\u003C/span>\u003Cspan style=\"color:#85E89D\">main\u003C/span>\u003Cspan style=\"color:#B392F0\"> class\u003C/span>\u003Cspan style=\"color:#E1E4E8\">=\u003C/span>\u003Cspan style=\"color:#9ECBFF\">\"max-w-4xl mx-auto py-8\"\u003C/span>\u003Cspan style=\"color:#E1E4E8\">>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">    &#x3C;\u003C/span>\u003Cspan style=\"color:#85E89D\">h1\u003C/span>\u003Cspan style=\"color:#B392F0\"> class\u003C/span>\u003Cspan style=\"color:#E1E4E8\">=\u003C/span>\u003Cspan style=\"color:#9ECBFF\">\"text-3xl font-bold\"\u003C/span>\u003Cspan style=\"color:#E1E4E8\">>欢迎来到 Astro 世界 🚀&#x3C;/\u003C/span>\u003Cspan style=\"color:#85E89D\">h1\u003C/span>\u003Cspan style=\"color:#E1E4E8\">>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">  &#x3C;/\u003C/span>\u003Cspan style=\"color:#85E89D\">main\u003C/span>\u003Cspan style=\"color:#E1E4E8\">>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">&#x3C;/\u003C/span>\u003Cspan style=\"color:#79B8FF\">Layout\u003C/span>\u003Cspan style=\"color:#E1E4E8\">>\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>提示\u003C/strong>：Astro 的 Frontmatter 部分在构建时在服务器端执行，不会暴露给客户端浏览器！\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 id=\"总结\">总结\u003C/h2>\n\u003Cp>Astro 极大地简化了现代全栈博客的构建难度，兼顾了顶级开发体验与极致的页面加载速度。如果你也在寻求一个高速、SEO 友好且易于扩展的博客解决方案，Astro 无疑是当下最佳选择之一。\u003C/p>",{"headings":71,"localImagePaths":81,"remoteImagePaths":82,"frontmatter":83,"imagePaths":86},[72,75,77,79],{"depth":31,"slug":73,"text":74},"为什么选择-astro","为什么选择 Astro？",{"depth":36,"slug":76,"text":76},"核心亮点",{"depth":31,"slug":78,"text":78},"快速代码示例",{"depth":31,"slug":80,"text":80},"总结",[],[],{"title":57,"description":58,"pubDate":84,"author":17,"tags":85,"heroImage":64},["Date","2026-08-15T00:00:00.000Z"],[61,62,63],[],"astro-guide.md","web-performance",{"id":88,"data":90,"body":99,"filePath":100,"digest":101,"rendered":102,"legacyId":126},{"title":91,"description":92,"pubDate":93,"author":17,"tags":94,"heroImage":98},"现代 Web 性能优化与 Core Web Vitals 终极指南","探索 LCP、FID/INP、CLS 等关键性能指标的优化策略，提升站点在 Google 搜索引擎中的权重与用户体验。",["Date","2026-08-18T00:00:00.000Z"],[95,96,97],"性能优化","SEO","WebVitals","https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=80","## 什么是 Core Web Vitals？\n\nGoogle 提出的 **Core Web Vitals** 是一组衡量 Web 用户体验的度量标准。它们主要聚焦于页面的**加载速度**、**交互响应度**以及**视觉稳定性**。\n\n### 关键指标解析\n\n| 指标名称 | 全称 | 优秀阈值 | 优化建议 |\n| :--- | :--- | :--- | :--- |\n| **LCP** | Largest Contentful Paint | ≤ 2.5s | 优化图片格式 (AVIF/WebP)，预加载关键字体与 CSS |\n| **INP** | Interaction to Next Paint | ≤ 200ms | 减少主线程阻塞任务，避免长任务 (Long Tasks) |\n| **CLS** | Cumulative Layout Shift | ≤ 0.1 | 显式为图片和视频声明 `width` 与 `height` |\n\n---\n\n## 最佳实践技巧\n\n### 1. 现代图片格式与响应式加载\n\n使用现代图片格式可以显著减小体积：\n\n```html\n\u003Cpicture>\n  \u003Csource srcset=\"image.avif\" type=\"image/avif\" />\n  \u003Csource srcset=\"image.webp\" type=\"image/webp\" />\n  \u003Cimg src=\"image.jpg\" alt=\"示例图片\" loading=\"lazy\" width=\"800\" height=\"600\" />\n\u003C/picture>\n```\n\n### 2. 静态 pre-rendering 与 CDN 边缘缓存\n\n静态站点托管在 Cloudflare Pages 或 Vercel 等边缘 CDN 网络，能让访问延迟降低到 50ms 以内。\n\n---\n\n## 总结\n\n性能不是可有可无的加分项，而是产品的核心竞争优势。通过 Astro 等现代 SSG 工具配合正确的优化策略，轻松实现 100 分 Lighthouse 满分！","src/content/blog/web-performance.md","9e94d24dc786692b",{"html":103,"metadata":104},"\u003Ch2 id=\"什么是-core-web-vitals\">什么是 Core Web Vitals？\u003C/h2>\n\u003Cp>Google 提出的 \u003Cstrong>Core Web Vitals\u003C/strong> 是一组衡量 Web 用户体验的度量标准。它们主要聚焦于页面的\u003Cstrong>加载速度\u003C/strong>、\u003Cstrong>交互响应度\u003C/strong>以及\u003Cstrong>视觉稳定性\u003C/strong>。\u003C/p>\n\u003Ch3 id=\"关键指标解析\">关键指标解析\u003C/h3>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003Ctable>\u003Cthead>\u003Ctr>\u003Cth align=\"left\">指标名称\u003C/th>\u003Cth align=\"left\">全称\u003C/th>\u003Cth align=\"left\">优秀阈值\u003C/th>\u003Cth align=\"left\">优化建议\u003C/th>\u003C/tr>\u003C/thead>\u003Ctbody>\u003Ctr>\u003Ctd align=\"left\">\u003Cstrong>LCP\u003C/strong>\u003C/td>\u003Ctd align=\"left\">Largest Contentful Paint\u003C/td>\u003Ctd align=\"left\">≤ 2.5s\u003C/td>\u003Ctd align=\"left\">优化图片格式 (AVIF/WebP)，预加载关键字体与 CSS\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd align=\"left\">\u003Cstrong>INP\u003C/strong>\u003C/td>\u003Ctd align=\"left\">Interaction to Next Paint\u003C/td>\u003Ctd align=\"left\">≤ 200ms\u003C/td>\u003Ctd align=\"left\">减少主线程阻塞任务，避免长任务 (Long Tasks)\u003C/td>\u003C/tr>\u003Ctr>\u003Ctd align=\"left\">\u003Cstrong>CLS\u003C/strong>\u003C/td>\u003Ctd align=\"left\">Cumulative Layout Shift\u003C/td>\u003Ctd align=\"left\">≤ 0.1\u003C/td>\u003Ctd align=\"left\">显式为图片和视频声明 \u003Ccode>width\u003C/code> 与 \u003Ccode>height\u003C/code>\u003C/td>\u003C/tr>\u003C/tbody>\u003C/table>\n\u003Chr>\n\u003Ch2 id=\"最佳实践技巧\">最佳实践技巧\u003C/h2>\n\u003Ch3 id=\"1-现代图片格式与响应式加载\">1. 现代图片格式与响应式加载\u003C/h3>\n\u003Cp>使用现代图片格式可以显著减小体积：\u003C/p>\n\u003Cpre class=\"astro-code github-dark\" style=\"background-color:#24292e;color:#e1e4e8; overflow-x: auto;\" tabindex=\"0\" data-language=\"html\">\u003Ccode>\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">&#x3C;\u003C/span>\u003Cspan style=\"color:#85E89D\">picture\u003C/span>\u003Cspan style=\"color:#E1E4E8\">>\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">  &#x3C;\u003C/span>\u003Cspan style=\"color:#85E89D\">source\u003C/span>\u003Cspan style=\"color:#B392F0\"> srcset\u003C/span>\u003Cspan style=\"color:#E1E4E8\">=\u003C/span>\u003Cspan style=\"color:#9ECBFF\">\"image.avif\"\u003C/span>\u003Cspan style=\"color:#B392F0\"> type\u003C/span>\u003Cspan style=\"color:#E1E4E8\">=\u003C/span>\u003Cspan style=\"color:#9ECBFF\">\"image/avif\"\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> />\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">  &#x3C;\u003C/span>\u003Cspan style=\"color:#85E89D\">source\u003C/span>\u003Cspan style=\"color:#B392F0\"> srcset\u003C/span>\u003Cspan style=\"color:#E1E4E8\">=\u003C/span>\u003Cspan style=\"color:#9ECBFF\">\"image.webp\"\u003C/span>\u003Cspan style=\"color:#B392F0\"> type\u003C/span>\u003Cspan style=\"color:#E1E4E8\">=\u003C/span>\u003Cspan style=\"color:#9ECBFF\">\"image/webp\"\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> />\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">  &#x3C;\u003C/span>\u003Cspan style=\"color:#85E89D\">img\u003C/span>\u003Cspan style=\"color:#B392F0\"> src\u003C/span>\u003Cspan style=\"color:#E1E4E8\">=\u003C/span>\u003Cspan style=\"color:#9ECBFF\">\"image.jpg\"\u003C/span>\u003Cspan style=\"color:#B392F0\"> alt\u003C/span>\u003Cspan style=\"color:#E1E4E8\">=\u003C/span>\u003Cspan style=\"color:#9ECBFF\">\"示例图片\"\u003C/span>\u003Cspan style=\"color:#B392F0\"> loading\u003C/span>\u003Cspan style=\"color:#E1E4E8\">=\u003C/span>\u003Cspan style=\"color:#9ECBFF\">\"lazy\"\u003C/span>\u003Cspan style=\"color:#B392F0\"> width\u003C/span>\u003Cspan style=\"color:#E1E4E8\">=\u003C/span>\u003Cspan style=\"color:#9ECBFF\">\"800\"\u003C/span>\u003Cspan style=\"color:#B392F0\"> height\u003C/span>\u003Cspan style=\"color:#E1E4E8\">=\u003C/span>\u003Cspan style=\"color:#9ECBFF\">\"600\"\u003C/span>\u003Cspan style=\"color:#E1E4E8\"> />\u003C/span>\u003C/span>\n\u003Cspan class=\"line\">\u003Cspan style=\"color:#E1E4E8\">&#x3C;/\u003C/span>\u003Cspan style=\"color:#85E89D\">picture\u003C/span>\u003Cspan style=\"color:#E1E4E8\">>\u003C/span>\u003C/span>\u003C/code>\u003C/pre>\n\u003Ch3 id=\"2-静态-pre-rendering-与-cdn-边缘缓存\">2. 静态 pre-rendering 与 CDN 边缘缓存\u003C/h3>\n\u003Cp>静态站点托管在 Cloudflare Pages 或 Vercel 等边缘 CDN 网络，能让访问延迟降低到 50ms 以内。\u003C/p>\n\u003Chr>\n\u003Ch2 id=\"总结\">总结\u003C/h2>\n\u003Cp>性能不是可有可无的加分项，而是产品的核心竞争优势。通过 Astro 等现代 SSG 工具配合正确的优化策略，轻松实现 100 分 Lighthouse 满分！\u003C/p>",{"headings":105,"localImagePaths":120,"remoteImagePaths":121,"frontmatter":122,"imagePaths":125},[106,109,111,113,116,119],{"depth":31,"slug":107,"text":108},"什么是-core-web-vitals","什么是 Core Web Vitals？",{"depth":36,"slug":110,"text":110},"关键指标解析",{"depth":31,"slug":112,"text":112},"最佳实践技巧",{"depth":36,"slug":114,"text":115},"1-现代图片格式与响应式加载","1. 现代图片格式与响应式加载",{"depth":36,"slug":117,"text":118},"2-静态-pre-rendering-与-cdn-边缘缓存","2. 静态 pre-rendering 与 CDN 边缘缓存",{"depth":31,"slug":80,"text":80},[],[],{"title":91,"description":92,"pubDate":123,"author":17,"tags":124,"heroImage":98},["Date","2026-08-18T00:00:00.000Z"],[95,96,97],[],"web-performance.md"]